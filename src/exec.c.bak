#include "minishell.h"

extern char **environ; 

static int	open_redir(t_cmd *c)
{
	int	fd;

	if (c->redir.infile)
	{
		fd = open(c->redir.infile, O_RDONLY);
		if (fd < 0)
		{
			perror(c->redir.infile);
			return (-1);
		}
		dup2(fd, STDIN_FILENO);
		close(fd);
	}
	if (c->redir.outfile)
	{
		if (c->redir.append)
			fd = open(c->redir.outfile, O_WRONLY | O_CREAT | O_APPEND, 0644);
		else
			fd = open(c->redir.outfile, O_WRONLY | O_CREAT | O_TRUNC, 0644);
		if (fd < 0)
		{
			perror(c->redir.outfile);
			return (-1);
		}
		dup2(fd, STDOUT_FILENO);
		close(fd);
	}
	return (0);
}

static void	child_process(t_cmd *c, int *pipefd, int prev_fd)
{
	char	*path;

	if (prev_fd != -1)
	{
		dup2(prev_fd, STDIN_FILENO);
		close(prev_fd);
	}
	if (c->next)
	{
		dup2(pipefd[1], STDOUT_FILENO);
	}
	close(pipefd[0]);
	close(pipefd[1]);
	if (open_redir(c) < 0)
		exit(1);
	if (c->argv && is_builtin(c->argv[0]))
		exit(run_builtin(c->argv));
	path = path_lookup(c->argv ? c->argv[0] : NULL);
	if (!path)
	{
		fprintf(stderr, "minishell: %s: command not found\n",
			c->argv ? c->argv[0] : "");
		exit(127);
	}
	execve(path, c->argv, environ);
	perror("execve");
	exit(126);
}

int	exec_pipeline(t_cmd *cmd)
{
	t_cmd	*c;
	int	pipefd[2];
	int	prev_fd;
	pid_t	pid;

	c = cmd;
	prev_fd = -1;
	while (c)
	{
		if (c->next)
			pipe(pipefd);
		pid = fork();
		if (pid == 0)
			child_process(c, pipefd, prev_fd);
		if (prev_fd != -1)
			close(prev_fd);
		if (c->next)
		{
			close(pipefd[1]);
			prev_fd = pipefd[0];
		}
		else
			prev_fd = -1;
		c = c->next;
	}
	while (wait(NULL) > 0)
		;
	return (0);
}

