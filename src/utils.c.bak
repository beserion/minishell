#include "minishell.h"

extern char **environ;

size_t	ms_strlen(const char *s)
{
	size_t	i = 0;

	if (!s)
		return (0);
	while (s[i])
		i++;
	return (i);
}

char	*ms_strdup(const char *s)
{
	size_t	n;
	char	*p;
	size_t	i;

	if (!s)
		return (NULL);
	n = ms_strlen(s);
	p = malloc(n + 1);
	if (!p)
		return (NULL);
	i = 0;
	while (i <= n)
	{
		p[i] = s[i];
		i++;
	}
	return (p);
}

char	*ms_strndup(const char *s, size_t n)
{
	size_t	i;
	char	*p;

	if (!s)
		return (NULL);
	i = 0;
	while (i < n && s[i])
		i++;
	p = malloc(i + 1);
	if (!p)
		return (NULL);
	n = 0;
	while (n < i)
	{
		p[n] = s[n];
		n++;
	}
	p[i] = '\0';
	return (p);
}

static char	*join_path(const char *dir, const char *cmd)
{
	char	*full;
	size_t	len1;
	size_t	len2;

	len1 = ms_strlen(dir);
	len2 = ms_strlen(cmd);
	full = malloc(len1 + len2 + 2);
	if (!full)
		return (NULL);
	strcpy(full, dir);
	full[len1] = '/';
	strcpy(full + len1 + 1, cmd);
	return (full);
}

char	*path_lookup(char *cmd)
{
	char	*path_env;
	char	*copy;
	char	*tok;
	char	*full;

	if (!cmd || !*cmd)
		return (NULL);
	if (strchr(cmd, '/'))
		return (ms_strdup(cmd));
	path_env = getenv("PATH");
	if (!path_env)
		return (NULL);
	copy = ms_strdup(path_env);
	if (!copy)
		return (NULL);
	tok = strtok(copy, ":");
	while (tok)
	{
		full = join_path(tok, cmd);
		if (full && access(full, X_OK) == 0)
		{
			free(copy);
			return (full);
		}
		free(full);
		tok = strtok(NULL, ":");
	}
	free(copy);
	return (NULL);
}

