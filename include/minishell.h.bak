#ifndef MINISHELL_H
# define MINISHELL_H

# include <unistd.h>
# include <stdlib.h>
# include <stdio.h>
# include <sys/types.h>
# include <sys/wait.h>
# include <fcntl.h>
# include <signal.h>
# include <string.h>
# include <errno.h>

typedef struct s_token
{
	char	**parts;
}	t_token;

typedef struct s_redir
{
	char	*infile;
	char	*outfile;
	int		append;
	int		here_doc;
	char	*heredoc_limiter;
}	t_redir;

typedef struct s_cmd
{
	char	**argv;
	int		argc;
	t_redir	redir;
	struct s_cmd	*next;
}	t_cmd;

size_t	ms_strlen(const char *s);
char	*ms_strdup(const char *s);
char	*ms_strndup(const char *s, size_t n);
char	**ms_split_whitespace(char *s);
t_token	*lexer(char *line);
void	token_clear(t_token *tok);
t_cmd	*parser(char *line);
void	cmd_clear(t_cmd *cmd);
int		exec_pipeline(t_cmd *cmd);
int		is_builtin(char *cmd);
int		run_builtin(char **argv);
char	*path_lookup(char *cmd);

#endif

